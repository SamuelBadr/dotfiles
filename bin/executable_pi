#!/usr/bin/env bash
# HPC login-node guard for pi.
set -u

# Real pi: env override, else the npm-global install under the newest nvm Node.
: "${REAL_PI:=$(printf '%s\n' "$HOME"/.nvm/versions/node/v*/bin/pi | sort -V | tail -1)}"
if [ ! -x "$REAL_PI" ]; then
  echo "pi: guard cannot find real pi (set REAL_PI=/path/to/pi to override)" >&2
  exit 127
fi
# npm pi is a `#!/usr/bin/env node` script; make its Node findable even when
# the calling shell (e.g. a long-lived herdr pane) has a stale PATH.
PATH="$(dirname "$REAL_PI"):$PATH"

# Default parallelism hint for the whole tree: read by OpenMP and GNU nproc.
export OMP_NUM_THREADS=8

# No hard CPU cap is possible (the cpu controller is not delegated to user
# cgroups here), so yield instead: lowest CPU priority for the whole tree, so
# other users win any contention and agents only soak up idle cores.
renice -n 19 -p $$ >/dev/null

# Memory/swap/task caps: a scope in the shared pi.slice (limits in
# ~/.config/systemd/user/pi.slice apply to all pi instances combined).
# Fails closed: without a systemd user manager, pi does not start.
exec systemd-run --user --scope --quiet --slice=pi.slice "$REAL_PI" "$@"
