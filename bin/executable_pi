#!/usr/bin/env bash
# HPC login-node guard for pi.
set -u

# Real pi: env override, else brew layout, else local layout.
: "${REAL_PI:="/opt/homebrew/bin/pi"}"
[ -x "$REAL_PI" ] || REAL_PI="/usr/local/bin/pi"
[ -x "$REAL_PI" ] || REAL_PI="$HOME/.local/bin/pi"
if [ ! -x "$REAL_PI" ]; then
  echo "pi: guard cannot find real pi (set REAL_PI=/path/to/pi to override)" >&2
  exit 127
fi

# Thread caps (inherited by all children) for the libs this stack actually reads.
export OMP_NUM_THREADS=8 OPENBLAS_NUM_THREADS=8 MKL_NUM_THREADS=8 JULIA_NUM_THREADS=8

# Gentle CPU/I/O priority for the whole tree.
renice -n 5 -p $$ >/dev/null 2>&1 || true
ionice -c 2 -n 4 -p $$ >/dev/null 2>&1 || true

# Primary: cgroup scope via the systemd user manager (hard memory/swap/task caps).
if [ -S "/run/user/$(id -u)/systemd/private" ]; then
  exec systemd-run --user --scope --quiet \
    --property=MemoryMax=64G --property=MemorySwapMax=0 \
    --property=TasksMax=1024 --property=CPUQuota=800% \
    "$REAL_PI" "$@"
fi

# Degraded: no systemd --user -> threads + priority only (no hard caps here).
echo "pi: no systemd --user; degraded guards (threads/nice/ionice, no hard caps)" >&2
exec "$REAL_PI" "$@"
