#!/usr/bin/env bash
# Update the user-level software on this machine: Homebrew, Julia (juliaup,
# the global and shared environments, Pkg apps), pi and its extensions, agent
# skills, Rust (rustup, cargo-installed tools), uv tools and a ~/bin/rex
# (rex-update). Tools that are
# missing here are skipped.
# Package/project environments are left alone: update those by hand.
#   up        this machine
#   up --all  this machine, hclm, frank and kauch in parallel (each pulls
#             the dotfiles first, so they run the same version of this script)
set -u
. "$HOME/.config/shell/common.sh"  # PATH; ssh and systemd shells lack it
jobs=2  # Julia + Cargo can compile together; leave room for the other lanes

# Run a tool and print its output only when it fails or when a line matches
# $1 (ANSI codes stripped for matching). Silent when nothing changed.
replay_if() {
  local keep="$1" out rc; shift
  out=$("$@" 2>&1); rc=$?
  if [ "$rc" -ne 0 ]; then printf '%s\n' "$out"; return "$rc"; fi
  printf '%s\n' "$out" | sed "s/$(printf '\033')\[[0-9;]*m//g" | grep -qE "$keep" && printf '%s\n' "$out"
  return 0
}
has() { command -v "$1" >/dev/null 2>&1; }
failed=()
step() { # <name> <command...>: run, remember failures, keep going
  local name=$1; shift
  "$@" || { echo "up: $name failed" >&2; failed+=("$name"); }
}
note() { # print a line for the --all summary (and to $UP_NOTES when set)
  echo "$*"; [ -n "${UP_NOTES:-}" ] && echo "$*" >>"$UP_NOTES"; return 0
}
notes() { { grep -h '^versions:' "$@"; grep -h '^up: skipped' "$@"; } | sed 's/^versions: //; s/^up: /  /' | tr '\n' ' '; }

# --all: fan out. Remote output is buffered per host and shown after the local run.
if [ "${1:-}" = --all ]; then
  logs=$(mktemp -d); pids=() hosts=()
  # chezmoi apply refuses (with --no-tty) to overwrite a file changed since the
  # last apply. That must fail the lane, but the machine still gets its software
  # updates, so capture the status and fold it into the exit code afterwards.
  # The leading newline matters: chezmoi's prompt writes no trailing newline, so
  # without it this notice lands mid-line and notes() (grep '^up: skipped') drops it.
  remote_cmd='chezmoi git -- pull -q --ff-only
apply_rc=0
chezmoi apply --no-tty --keep-going || { printf "\nup: skipped chezmoi apply, see chezmoi diff\n"; apply_rc=1; }
~/bin/up; rc=$?
[ "$apply_rc" = 1 ] && [ "$rc" = 0 ] && rc=1
exit "$rc"'
  for pair in hclm:master.cluster frank:ftuw kauch:kauch01; do
    h=${pair%%:*}; [ "$(uname -n)" = "${pair#*:}" ] && continue
    ssh -o BatchMode=yes -o ConnectTimeout=10 "$h" "bash -lc $(printf '%q' "$remote_cmd")" \
      >"$logs/$h" 2>&1 </dev/null &
    pids+=($!); hosts+=("$h")
  done
  apply_rc=0
  chezmoi update --no-tty --keep-going || {
    printf '\nup: skipped chezmoi apply, see chezmoi diff\n' | tee "$logs/local.notes"
    apply_rc=1
  }
  UP_NOTES=$logs/local.notes "$0"; rc=$?
  [ "$apply_rc" = 1 ] && [ "$rc" = 0 ] && rc=1
  summary=("$(printf '%-6s %-7s' local "$([ $rc = 0 ] && echo ok || echo FAILED)") $(notes "$logs/local.notes")")
  for i in "${!hosts[@]}"; do
    wait "${pids[$i]}"; rc=$?; h=${hosts[$i]}
    printf '\n===== %s =====\n' "$h"; cat "$logs/$h"
    summary+=("$(printf '%-6s %-7s' "$h" "$([ $rc = 0 ] && echo ok || echo FAILED)") $(notes "$logs/$h")")
  done
  rm -rf "$logs"
  printf '\n'; printf '%s\n' "${summary[@]}"
  ! printf '%s\n' "${summary[@]}" | grep -q FAILED
  exit
fi

# Independent lanes, with buffered output and failures collected in the parent.
logs=$(mktemp -d); pids=() lanes=()
background() {
  local name=$1; shift
  ( failed=(); "$@" || exit $?; [ ${#failed[@]} = 0 ] ) >"$logs/$name" 2>&1 &
  pids+=($!); lanes+=("$name")
}
# Refresh only metadata alongside the tools; defer upgrades until they exit,
# so Homebrew cannot replace Node, Juliaup, etc. underneath a running update.
has brew && background brew replay_if '==> (New|Updated|Renamed|Deleted) (Formulae|Casks)|==> New Versions' brew update --quiet

update_pi() {
  if has pi; then
    # Real changes: an extension checkout reset ("HEAD is now at"), a fresh
    # clone, or a self update. The bare "git fetch ... -> FETCH_HEAD" lines
    # print EVERY run for pinned @main repos even when upstream is unchanged,
    # so they are noise, not a signal.
    step pi replay_if 'HEAD is now at|Cloning into|Updated pi |Update note' pi update --all
    step pi-models replay_if '[Ee]rror|[Ff]ail' pi update --models
  fi
}
update_skills() {
  # skills-sync already updates skills; do not run the CLI a second time.
  if has skills-sync; then
    step skills-sync replay_if 'skills-sync:|Updated |[Ee]rror|[Ff]ail' skills-sync
  elif has skills; then
    step skills replay_if 'Updated |[Ee]rror|[Ff]ail' skills update -g -y
  fi
}
update_rust() {
  if has rustup && rustc --version >/dev/null 2>&1; then
    step rustup replay_if ' updated |^  [^ ]+ installed|[Ee]rror' rustup update
    # Git and path installs (a "(" after the version) are left alone.
    crates=$(cargo install --list | awk '/^[^ ].*:$/ && !/\(/ {print $1}')
    [ -n "$crates" ] && step cargo replay_if 'Replac|Installed|[Ee]rror' cargo install --locked -j $jobs $crates
  fi
  return 0
}
background pi update_pi
background skills update_skills
background rust update_rust
has uv && background uv replay_if 'Updated|[Ee]rror' uv tool upgrade --all
# Only the sudo-free copy; a system rex package updates with the OS.
[ -x "$HOME/bin/rex" ] && has rex-update && background rex rex-update

if has juliaup; then
  # juliaup deletes the julia it replaces, which breaks running julias (here
  # or in Slurm jobs sharing this home) that later start workers or load files.
  busy=$(pgrep -u "$USER" -x julia | tr '\n' ' ')
  [ -n "$busy" ] && busy="julia pids ${busy% }"
  has squeue && [ -n "$(squeue -h -u "$USER" -t R,CG)" ] && busy="${busy:+$busy, }Slurm jobs"
  old_julia=$(julia --version 2>/dev/null)
  if [ -n "$busy" ]; then
    note "up: skipped juliaup update (running: $busy)"
  else
    step juliaup replay_if 'Installing|Updating channel|[Ee]rror' juliaup update
  fi
  # Global env of the current version (seeded from the newest older one when
  # new), shared envs used in the last 30 days, then Pkg apps, which also
  # repoints their shims at the current julia. Pkg output is shown on failure only.
  [ "$(julia --version 2>/dev/null)" != "$old_julia" ] && new_julia=1 || new_julia=
  step julia env JULIA_NUM_PRECOMPILE_TASKS=$jobs UP_NEW_JULIA=$new_julia UP_STATE="${XDG_STATE_HOME:-$HOME/.local/state}/up" OPENBLAS_NUM_THREADS=1 JULIA_NUM_THREADS=1 julia --startup-file=no -e '
    using Pkg, TOML, Dates, Logging, FileWatching
    envs = joinpath(DEPOT_PATH[1], "environments")
    cur = "v$(VERSION.major).$(VERSION.minor)"
    isver(d) = occursin(r"^v\d+\.\d+$", d)
    if !isfile(joinpath(envs, cur, "Project.toml"))
        old = sort(filter(d -> isver(d) && isfile(joinpath(envs, d, "Project.toml")) &&
                               VersionNumber(d[2:end]) < VERSION, readdir(envs)); by = d -> VersionNumber(d[2:end]))
        isempty(old) || (mkpath(joinpath(envs, cur)); cp(joinpath(envs, last(old), "Project.toml"), joinpath(envs, cur, "Project.toml")))
    end
    log = joinpath(DEPOT_PATH[1], "logs", "manifest_usage.toml")
    usage = isfile(log) ? TOML.parsefile(log) : Dict{String, Any}()
    recent = [dirname(m) for (m, v) in usage if maximum(e["time"] for e in v) > now(UTC) - Day(30)]
    shared = filter(readdir(envs)) do d
        p = joinpath(envs, d)
        isfile(joinpath(p, "Project.toml")) && (d == cur || p in recent && !isver(d) && !startswith(d, "__") && !endswith(d, "tempenv"))
    end
    function quiet(f) # run f with all output captured; returns (succeeded, output)
        path = tempname()
        ok = open(path, "w") do io
            redirect_stdio(stdout = io, stderr = io) do
                with_logger(ConsoleLogger(io)) do
                    try f(); true catch e showerror(io, e); println(io); false end
                end
            end
        end
        out = read(path, String); rm(path); ok, out
    end
    bad = String[]
    fail(what, out) = (print(stderr, out); push!(bad, what))
    ok, out = quiet(Pkg.Registry.update); ok || fail("registry", out)
    deps() = Dict(p.name => (string(p.version), p.is_direct_dep) for p in values(Pkg.dependencies()))
    Pkg.autoprecompilation_enabled(false)  # precompile below only where something changed
    for d in shared
        Pkg.activate(joinpath(envs, d); io = devnull)
        old = deps()
        local ok, out = quiet(() -> Pkg.update(; update_registry = false))
        new = deps()
        ch = [n for (n, v) in new if get(old, n, nothing) != v]
        ok && (!isempty(ch) || !isempty(ENV["UP_NEW_JULIA"])) && ((ok, out) = quiet(Pkg.precompile))
        list = length(ch) <= 5 ? sort(ch) : [n for n in sort(ch) if last(new[n])]  # all if few, else direct deps
        desc = [string(n, " ", first(get(old, n, ("new",))), " ⇒ ", first(new[n])) for n in list]
        println("julia: @", d, ": ", isempty(ch) ? "up to date" : "$(length(ch)) package(s) updated",
                isempty(desc) ? "" : " (" * join(desc, ", ") * ")")
        ok || fail("@" * d, out)
        ok && foreach(l -> occursin(r"✗|ERROR", l) && println(stderr, l), eachline(IOBuffer(out)))
    end
    Pkg.autoprecompilation_enabled(true)
    # Updating marked these envs as used; restore their real last use so the
    # 30-day filter above still sees only use by you.
    isfile(log) && mkpidlock(log * ".pid"; stale_age = 3) do
        u = TOML.parsefile(log)
        for d in shared, (k, v) in usage
            dirname(k) == joinpath(envs, d) && (u[k] = v)
        end
        open(io -> TOML.print(io, u; sorted = true), log * ".up", "w"); mv(log * ".up", log; force = true)
    end
    # Apps: reinstalling one takes seconds, so skip it while its upstream (the
    # branch head, or the latest registered version) and this julia are unchanged.
    # shortcut: the app'"'"'s own dependencies only update along with it.
    function upstream(info)
        if haskey(info, "repo-url")
            rev = get(info, "repo-rev", "HEAD")
            r = try split(readchomp(`git ls-remote $(info["repo-url"]) $rev`))[1] catch; rev end
            return isempty(r) ? rev : r
        end
        haskey(info, "path") && return nothing  # developed app: always update
        vs = VersionNumber[]
        for reg in Pkg.Registry.reachable_registries()
            e = get(reg, Base.UUID(info["uuid"]), nothing)
            e === nothing || append!(vs, [v for (v, i) in Pkg.Registry.registry_info(reg, e).version_info if !i.yanked])
        end
        isempty(vs) ? nothing : string(maximum(vs))
    end
    apps = joinpath(envs, "apps", "AppManifest.toml")
    seenfile = joinpath(ENV["UP_STATE"], "julia-apps.toml")
    seen = isfile(seenfile) ? TOML.parsefile(seenfile) : Dict{String, Any}()
    for (name, entry) in (isfile(apps) ? TOML.parsefile(apps)["deps"] : Dict{String, Any}())
        info = only(entry)
        id = upstream(info)
        key = id === nothing ? nothing : string(id, " ", Sys.BINDIR)
        key !== nothing && get(seen, name, nothing) == key && continue
        local ok, out = quiet(() -> Pkg.Apps.update(name))  # one by one: a broken app must not block the rest
        ok || (fail("app " * name, out); continue)
        println("julia: app ", name, ": updated")
        key === nothing || (seen[name] = key)
    end
    mkpath(ENV["UP_STATE"]); open(io -> TOML.print(io, seen; sorted = true), seenfile, "w")
    isempty(bad) || (println(stderr, "julia: failed: ", join(bad, ", ")); exit(1))'
fi

for i in "${!lanes[@]}"; do
  wait "${pids[$i]}" || failed+=("${lanes[$i]}")
  cat "$logs/${lanes[$i]}"
done
rm -rf "$logs"
if has brew; then
  step brew env HOMEBREW_NO_AUTO_UPDATE=1 brew upgrade --greedy --overwrite -y
  # brew upgrade cleans upgraded packages; full cache cleanup is manual.
fi

v() { local out; has "$1" && out=$("$@" 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+[^ ]*' | head -1); echo "${out:--}"; }
note "versions: julia $(v julia --version) | rustc $(v rustc --version) | pi $(v pi --version)"
[ ${#failed[@]} = 0 ] || { echo "up: failed: ${failed[*]}" >&2; exit 1; }
