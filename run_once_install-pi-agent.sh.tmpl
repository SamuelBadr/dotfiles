#!/usr/bin/env bash
# Install Pi Coding Agent
# This script runs once on first chezmoi apply

set -euo pipefail

echo "==> Installing Pi Coding Agent..."

# Check if pi is already installed
if command -v pi &> /dev/null; then
    echo "✓ pi already installed at $(which pi)"
    pi --version 2>/dev/null || echo "  (version check failed)"
    exit 0
fi

# Try npm first (most common)
if command -v npm &> /dev/null; then
    echo "Installing via npm..."
    npm install -g @earendil-works/pi-coding-agent
    
    if command -v pi &> /dev/null; then
        echo "✓ pi installed successfully"
        pi --version 2>/dev/null || true
        exit 0
    fi
fi

# Try uv/pip (Python)
if command -v uv &> /dev/null; then
    echo "Installing via uv..."
    uv pip install --global @earendil-works/pi-coding-agent 2>/dev/null || \
    uv tool install @earendil-works/pi-coding-agent 2>/dev/null || true
    
    if command -v pi &> /dev/null; then
        echo "✓ pi installed successfully via uv"
        exit 0
    fi
fi

# Try pip as fallback
if command -v pip &> /dev/null; then
    echo "Installing via pip..."
    pip install --user @earendil-works/pi-coding-agent 2>/dev/null || true
    
    if command -v pi &> /dev/null; then
        echo "✓ pi installed successfully via pip"
        exit 0
    fi
fi

# Try homebrew (macOS)
if command -v brew &> /dev/null; then
    echo "Installing via homebrew..."
    brew install @earendil-works/pi-coding-agent 2>/dev/null || true
    
    if command -v pi &> /dev/null; then
        echo "✓ pi installed successfully via brew"
        exit 0
    fi
fi

echo "⚠ Could not install pi automatically."
echo ""
echo "Manual installation options:"
echo "  npm:  npm install -g @earendil-works/pi-coding-agent"
echo "  uv:   uv tool install @earendil-works/pi-coding-agent"
echo "  pip:  pip install --user @earendil-works/pi-coding-agent"
echo ""
echo "Then run: pi"
