# ~/.zshrc is a zsh configuration. Keep accidental attempts to source it from
# Bash (or another shell) from producing a cascade of zsh-specific errors.
if [ -z "${ZSH_VERSION:-}" ]; then
  if [ -n "${BASH_VERSION:-}" ]; then
    printf '%s\n' \
      '~/.zshrc is for zsh, not Bash.' \
      'Start zsh with: exec zsh' \
      'Make it the login shell with: chsh -s "$(command -v zsh)"' >&2
  fi
  return 0 2>/dev/null || exit 0
fi

# ============================================================================
# Platform / Homebrew
# ============================================================================
# Initialize Homebrew early so later command checks can find brew-installed tools.
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif command -v brew >/dev/null 2>&1; then
  eval "$(brew shellenv)"
fi

# ============================================================================
# Shared Environment (EDITOR, PATH, GITHUB_USERNAME, up, pluto)
# ============================================================================
# Shell-neutral configuration lives here so zsh and the bash fallback stay in
# sync. Load after Homebrew so brew-installed tool dirs are on PATH already.
[[ -r $HOME/.config/shell/common.sh ]] && . "$HOME/.config/shell/common.sh"

# Load the Parallel API key from macOS Keychain without storing it in dotfiles.
if [[ -z ${PARALLEL_API_KEY:-} ]] && command -v security >/dev/null 2>&1; then
  PARALLEL_API_KEY=$(security find-generic-password -a "$USER" -s pi-parallel-api-key -w 2>/dev/null) && export PARALLEL_API_KEY
fi

# ============================================================================
# History Configuration
# ============================================================================
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000

setopt SHARE_HISTORY              # Share history between all sessions
setopt HIST_IGNORE_ALL_DUPS       # Remove older duplicate entries from history
setopt HIST_REDUCE_BLANKS         # Remove superfluous blanks from history items
setopt INC_APPEND_HISTORY         # Write to history file immediately, not when shell exits
setopt HIST_IGNORE_SPACE          # Don't record commands starting with space
setopt HIST_VERIFY                # Show command with history expansion before running it

# ============================================================================
# Zsh Options
# ============================================================================
setopt AUTO_CD                    # cd by typing directory name if it's not a command
setopt INTERACTIVE_COMMENTS       # Allow comments in interactive shells

# ============================================================================
# Completion System
# ============================================================================
typeset -U fpath
if [[ -n ${HOMEBREW_PREFIX:-} && -d $HOMEBREW_PREFIX/share/zsh-completions ]]; then
  fpath=("$HOMEBREW_PREFIX/share/zsh-completions" $fpath)
fi
if [[ -r $BUN_INSTALL/_bun ]]; then
  fpath=("$BUN_INSTALL" $fpath)
fi

zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path ~/.zsh/cache
[[ -d ~/.zsh/cache ]] || mkdir -p ~/.zsh/cache

autoload -Uz compinit && compinit

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'       # Case insensitive matching
zstyle ':completion:*' group-name ''                             # Group results by category
zstyle ':completion:*:descriptions' format '%B%d%b'              # Bold descriptions
zstyle ':completion:*:warnings' format 'No matches for: %d'      # Warning format
zstyle ':completion:*' verbose yes                               # Verbose completion
zstyle ':completion:*:*:kill:*' menu yes select                  # Process completion
zstyle ':completion:*:kill:*' force-list always

# ============================================================================
# Key Bindings
# ============================================================================
bindkey -e

autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search

bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search
bindkey '^P' up-line-or-beginning-search
bindkey '^N' down-line-or-beginning-search

# ============================================================================
# Plugin Loading
# ============================================================================
ZSH_PLUGIN_DIRS=(
  /opt/homebrew/share              # macOS Homebrew
  /usr/share/zsh/plugins           # Arch Linux
  /usr/share                       # Other Linux distros
  "$HOME/.local/share/zsh/plugins" # User-local installs
)

source_plugin() {
  local plugin=$1
  local dir plugin_file

  for dir in "${ZSH_PLUGIN_DIRS[@]}"; do
    plugin_file="$dir/$plugin/$plugin.zsh"
    [[ -r $plugin_file ]] && source "$plugin_file" && return 0
  done

  return 1
}

source_plugin zsh-autosuggestions && {
  ZSH_AUTOSUGGEST_STRATEGY=(history completion)
  ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE=20
  ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=244'
}

# Syntax highlighting should be loaded after other plugins.
source_plugin zsh-syntax-highlighting

# ============================================================================
# Prompt (load last)
# ============================================================================
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init zsh)"
fi
# Puppeteer: snap Chromium exists only on some Linux machines; no-op elsewhere.
if [[ $OSTYPE == linux* && -x /snap/chromium/current/usr/lib/chromium-browser/chrome ]]; then
  export PUPPETEER_EXECUTABLE_PATH=/snap/chromium/current/usr/lib/chromium-browser/chrome
fi
export TUWIEN_CUID=sbadr@tuwien.ac.at
