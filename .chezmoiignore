# Chezmoi ignore patterns
# Files matching these patterns won't be managed by chezmoi

# Julia Manifest files (auto-generated, should not be tracked)
.julia/environments/**/Manifest.toml

# macOS
.DS_Store

# Temporary files
*.tmp
*.swp
*~

# Pi coding agent: private/volatile state
.pi/agent/sessions/
.pi/agent/sessions/**

# Usually generated/temporary
.pi/agent/logs/
.pi/agent/logs/**
.pi/agent/cache/
.pi/agent/cache/**
.pi/agent/tmp/
.pi/agent/tmp/**
.pi/agent/node_modules/
.pi/agent/node_modules/**
.pi/agent/npm/
.pi/agent/npm/**
.pi/agent/git/
.pi/agent/git/**
.pi/agent/skills/*/.git/**

# Pi credentials are machine-local and must never be managed by chezmoi
.pi/agent/auth.json
