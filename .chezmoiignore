# Chezmoi ignore patterns
# Files matching these patterns won't be managed by chezmoi

# Repository-only Homebrew manifest. HOMEBREW_BUNDLE_FILE points brew at the
# source copy so `brew bundle add/remove` edit it in place; never deploy to ~.
Brewfile

# Julia: global env Project.toml/Manifest.toml are machine-local churn
# (startup.jl config is still tracked).
.julia/environments/**/Project.toml
.julia/environments/**/Manifest.toml

# macOS
.DS_Store

# Python bytecode caches
**/__pycache__/**

# Skill bodies are installed by the `skills` CLI from upstream. Only the wanted
# list (.agents/skills.txt) is tracked; ~/bin/skills-sync installs it on every
# machine. The CLI's lock describes what one machine has installed, so syncing
# it makes `skills update` skip skills that are missing or stale locally.
.agents/skills/**
.agents/.skill-lock.json

# ~/.pi/agent/skills/ is a runtime dir (older `skills` versions symlinked there).
# Pi discovers skills natively from ~/.agents/skills/, so this dir must never be
# managed by chezmoi.
.pi/agent/skills/**

# Temporary files
*.tmp
*.swp
*~

# Pi coding agent: private/volatile state
.pi/agent/sessions/

# Usually generated/temporary
.pi/agent/logs/
.pi/agent/cache/
.pi/agent/tmp/
.pi/agent/node_modules/
.pi/agent/npm/

# Pi package install cache — pi reinstates everything in settings.json "packages"
# on demand, so the whole dir is runtime state and must never be tracked.
.pi/agent/git/**

# Pi credentials are machine-local and must never be managed by chezmoi
.pi/agent/auth.json

# Machine-local chezmoi config (holds per-machine module overrides like
# [data.modules] workstation = true). Must NOT be managed by chezmoi itself.
.config/chezmoi/chezmoi.toml

# Backup configuration belongs only to the explicitly opted-in Mac.
.config/restic-hclm/archive/**
{{- if not (and (eq .chezmoi.os "darwin") .modules.backupMac) }}
.config/restic-hclm
.config/restic-hclm/**
Library
{{- end }}

# HPC login-node guard: `bin/pi` wrapper and its pi.slice only where
# [data] hpcLoginNode = true.
{{- if not .hpcLoginNode }}
bin/pi
.config/systemd/user/pi.slice
{{- end }}

# systemd user units (the daily skills-sync timer) only on Linux.
{{- if ne .chezmoi.os "linux" }}
.config/systemd
.config/systemd/**
{{- end }}

# Workstation-only files (gated here rather than with in-file templates).
{{- if not .modules.workstation }}
.config/starship.toml
{{- end }}
{{- if not (and (eq .chezmoi.os "darwin") .modules.workstation) }}
.chezmoiscripts/macos-keyboard.sh
{{- end }}
