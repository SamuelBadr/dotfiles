# Chezmoi ignore patterns
# Files matching these patterns won't be managed by chezmoi

# Repository-only regression checks.
tests

# Repository-only Homebrew manifest. HOMEBREW_BUNDLE_FILE points brew at the
# source copy so `brew bundle add/remove` edit it in place; never deploy to ~.
Brewfile

# Julia: global env Project.toml/Manifest.toml are machine-local churn
# (startup.jl config is still tracked).
.julia/environments/**/Project.toml
.julia/environments/**/Manifest.toml

# macOS
.DS_Store

# Python bytecode caches
**/__pycache__/**

# All skills and lock metadata are managed by the `skills` CLI.
.agents/skills/**
.agents/.skill-lock.json

# ~/.pi/agent/skills/ is a runtime dir for symlinks created by the `skills` CLI.
# Pi discovers skills natively from ~/.agents/skills/ (tracked above), so this dir
# must never be managed by chezmoi.
.pi/agent/skills/**

# Temporary files
*.tmp
*.swp
*~

# Pi coding agent: private/volatile state
.pi/agent/sessions/

# Usually generated/temporary
.pi/agent/logs/
.pi/agent/cache/
.pi/agent/tmp/
.pi/agent/node_modules/
.pi/agent/npm/

# Pi package install cache — pi reinstates everything in settings.json "packages"
# on demand, so the whole dir is runtime state and must never be tracked.
.pi/agent/git/**

# Pi credentials are machine-local and must never be managed by chezmoi
.pi/agent/auth.json

# Machine-local chezmoi config (holds per-machine module overrides like
# [data.modules] workstation = true). Must NOT be managed by chezmoi itself.
.config/chezmoi/chezmoi.toml

# Backup configuration belongs only to the explicitly opted-in Mac.
.config/restic-hclm/archive/**
{{- if not (and (eq .chezmoi.os "darwin") .modules.backupMac) }}
.config/restic-hclm
.config/restic-hclm/**
Library
{{- end }}

# HPC login-node guard: deployed only where [data] hpcLoginNode = true
{{- if not .hpcLoginNode }}
bin/pi
.pi/agent/AGENTS.md
{{- end }}
