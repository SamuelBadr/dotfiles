# Preserve the existing POSIX login environment, if present.
if [ -r "$HOME/.profile" ]; then
  . "$HOME/.profile"
fi

# Keep user-installed commands, including chezmoi, on PATH.
export PATH="$HOME/bin:$PATH"

# The cluster keeps /bin/bash as the account shell; use user-local zsh for
# interactive login sessions when available.
if [[ $- == *i* && -x "$HOME/.local/bin/zsh" ]]; then
  exec "$HOME/.local/bin/zsh" -l
fi

# Login bash reads only this file: read ~/.bashrc too (common.sh, then the
# interactive setup), unless ~/.profile already did, as Ubuntu's default does.
if [ -z "${__bashrc_read-}" ] && [ -f "$HOME/.bashrc" ]; then
  . "$HOME/.bashrc"
fi
