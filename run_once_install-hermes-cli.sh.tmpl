{{- if not .modules.hermes -}}
#!/usr/bin/env bash
# Hermes module is disabled. Exiting.
exit 0
{{- else -}}
#!/usr/bin/env bash
# Install Hermes CLI if not already installed
# Tries multiple methods: pip, uv, or direct download

set -e

echo "==> Checking for Hermes CLI..."

if command -v hermes &> /dev/null; then
    echo "  ✓ Hermes already installed: $(hermes --version 2>&1 | head -1)"
    exit 0
fi

echo "  Hermes CLI not found, installing..."

# Method 1: Try hermes-cli package (if available)
echo "  Trying: pip install hermes-cli..."
if command -v pip3 &> /dev/null; then
    PIP="pip3"
elif command -v pip &> /dev/null; then
    PIP="pip"
elif command -v python3 &> /dev/null; then
    PIP="python3 -m pip"
else
    PIP=""
fi

if [[ -n "$PIP" ]]; then
    if $PIP install --user --quiet hermes-cli 2>/dev/null; then
        if command -v hermes &> /dev/null; then
            echo "  ✓ Installed via pip (hermes-cli)"
        else
            echo "  ⚠ pip install succeeded but hermes not found in PATH"
        fi
    else
        echo "  ⚠ hermes-cli not available via pip"
    fi
fi

# Method 2: Try uv (faster, often has more packages)
if ! command -v hermes &> /dev/null && command -v uv &> /dev/null; then
    echo "  Trying: uv pip install hermes-cli..."
    uv pip install --user hermes-cli 2>/dev/null || true
fi

# Final check
if command -v hermes &> /dev/null; then
    echo "  ✓ Hermes installed: $(hermes --version 2>&1 | head -1)"
    
    # Ensure ~/.local/bin is in PATH
    if [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
        echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.zshrc
        export PATH="$HOME/.local/bin:$PATH"
        echo "  Added ~/.local/bin to PATH"
    fi
else
    echo ""
    echo "  ⚠ Auto-install failed. Manual options:"
    echo ""
    echo "  1. If you have uv:"
    echo "     uv pip install --user hermes-cli"
    echo ""
    echo "  2. Or check if available via your cluster's module system:"
    echo "     module avail hermes  # or similar"
    echo ""
    echo "  3. Or install from source (if you have the repo)"
    echo ""
    # Don't fail - let user continue with other tools
fi
{{- end -}}
