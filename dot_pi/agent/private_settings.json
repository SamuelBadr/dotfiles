{
  "lastChangelogVersion": "0.80.6",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "max",
  "theme": "light/dark",
  "enableInstallTelemetry": false,
  "packages": [
    "npm:pi-markdown-preview",
    "npm:pi-subagents",
    "npm:@plannotator/pi-extension",
    "npm:pi-web-access"
  ],
  "enabledModels": [
    "aqueduct/coding",
    "openai-codex/gpt-5.5",
    "aqueduct/large",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-luna"
  ],
  "subagents": {
    "defaultModel": "aqueduct/main",
    "modelScope": {
      "enforce": true,
      "allow": [
        "openai-codex/gpt-5.6-*",
        "aqueduct/main",
        "aqueduct/coding",
        "aqueduct/large",
        "aqueduct/tiny",
        "aqueduct/util",
        "aqueduct/vision",
        "aqueduct/ocr"
      ]
    },
    "agentOverrides": {
      "delegate": {
        "model": "aqueduct/util",
        "fallbackModels": [
          "aqueduct/tiny",
          "aqueduct/main"
        ]
      },
      "scout": {
        "model": "aqueduct/coding",
        "thinking": "low",
        "fallbackModels": [
          "aqueduct/main",
          "aqueduct/large"
        ]
      },
      "context-builder": {
        "model": "aqueduct/large",
        "thinking": "medium",
        "fallbackModels": [
          "aqueduct/main",
          "aqueduct/coding"
        ]
      },
      "researcher": {
        "model": "aqueduct/main",
        "thinking": "medium",
        "fallbackModels": [
          "aqueduct/large",
          "aqueduct/coding"
        ]
      },
      "planner": {
        "model": "aqueduct/large",
        "thinking": "high",
        "fallbackModels": [
          "aqueduct/main",
          "aqueduct/coding"
        ]
      },
      "oracle": {
        "model": "aqueduct/large",
        "thinking": "high",
        "fallbackModels": [
          "aqueduct/main",
          "aqueduct/coding"
        ]
      },
      "worker": {
        "model": "aqueduct/coding",
        "thinking": "medium",
        "fallbackModels": [
          "aqueduct/main",
          "aqueduct/large"
        ]
      },
      "reviewer": {
        "model": "aqueduct/large",
        "thinking": "high",
        "fallbackModels": [
          "aqueduct/coding",
          "aqueduct/main"
        ]
      },
      "verifier": {
        "model": "aqueduct/main",
        "fallbackModels": [
          "aqueduct/large",
          "aqueduct/coding"
        ]
      }
    }
  }
}