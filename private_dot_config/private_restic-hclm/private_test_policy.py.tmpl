"""Run with python3 ~/.config/restic-hclm/test_policy.py; no network or backups."""
import os
from pathlib import Path
import subprocess
import tempfile

root = Path(__file__).parent
with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    def stub(name, body):
        p = tmp / name
        p.write_text('#!/bin/sh\n' + body + '\n')
        p.chmod(0o700)
        return str(p)

    stub('pmset', 'echo "Now drawing from \'$POWER\'"')
    stub('timeout', 'shift; exec "$@"')
    stub('ssh', 'echo ssh >> "$TRACE"; exit "$NETWORK"')
    job = stub('job', 'echo job >> "$TRACE"; exit "$RESULT"')
    env = dict(os.environ, PATH=f'{tmp}:/usr/bin:/bin', TRACE=str(tmp / 'trace'))
    for power, network, result, expected, trace in [
        ('Battery Power', '0', '0', 0, ''),
        ('AC Power', '1', '0', 0, 'ssh\n'),
        ('AC Power', '0', '0', 0, 'ssh\njob\n'),
        ('AC Power', '0', '3', 3, 'ssh\njob\n'),
    ]:
        (tmp / 'trace').write_text('')
        p = subprocess.run([str(root / 'run-on-ac'), job], env=dict(env, POWER=power, NETWORK=network, RESULT=result), capture_output=True)
        assert p.returncode == expected, p.stderr
        assert (tmp / 'trace').read_text() == trace

    restic = stub('restic', 'exit "$RESULT"')
    policy = tmp / 'policy'
    policy.write_text((root / 'restic-backup-exit-policy').read_text().replace('/opt/homebrew/bin/restic', restic))
    for result in (0, 1, 3):
        p = subprocess.run(['/bin/sh', str(policy)], env=dict(env, RESULT=str(result)), capture_output=True)
        assert p.returncode == result
        if result == 3:
            assert b'Partial backup' in p.stderr
print('PASS: battery/network skips, execution, and failure propagation')

# Exercise real restic selection on tiny synthetic files, never personal data.
import json
with tempfile.TemporaryDirectory() as tmp:
    tmp = Path(tmp)
    home = tmp / 'home'
    keep = ['Projects/demo/src/main.rs', 'Projects/demo/.git/config',
            'Finances/budget.csv', '.ssh/key', '.julia/dev/local/code.jl',
            'Library/Mobile Documents/example.txt', 'Pictures/photo.jpg']
    omit = ['Movies/movie.mp4', 'Library/Caches/cache', '.cache/cache',
            '.omlx/models/download', 'Projects/demo/node_modules/pkg/index.js',
            'Projects/demo/target/output']
    for name in keep + omit:
        p = home / name
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text('synthetic test data')
    (home / 'Projects/demo/target/CACHEDIR.TAG').write_text(
        'Signature: 8a477f597d28d172789f06886806bc55\n')
    for name in ('sources', 'excludes'):
        (tmp / name).write_text((root / name).read_text().replace('{{ .chezmoi.homeDir }}', str(home)))
    env = dict(PATH='/opt/homebrew/bin:/usr/bin:/bin', HOME=str(tmp),
               RESTIC_PASSWORD='disposable-local-test-only')
    def restic(*args):
        return subprocess.run(['/opt/homebrew/bin/restic', '--repo', str(tmp / 'repo'),
                               '--no-cache', *args], env=env, check=True,
                              capture_output=True, text=True, timeout=30).stdout
    restic('init')
    restic('backup', '--files-from=' + str(tmp / 'sources'),
           '--exclude-file=' + str(tmp / 'excludes'), '--exclude-caches')
    paths = {item.get('path') for line in restic('ls', '--json', 'latest').splitlines()
             if (item := json.loads(line)).get('type') == 'file'}
    for name in keep:
        assert str(home / name) in paths, ('missing', name)
    for name in omit:
        assert str(home / name) not in paths, ('unexpected', name)
print('PASS: real restic scope preserves personal/source data and excludes caches')
