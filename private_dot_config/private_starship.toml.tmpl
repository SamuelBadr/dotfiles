{{- if .modules.workstation -}}
# Minimal starship prompt

format = '\[$hostname$directory$git_branch$git_status\] $character'
add_newline = true
scan_timeout = 10
command_timeout = 200

[hostname]
format = '$hostname '
ssh_only = true
trim_at = '.'

[directory]
format = '$path'
style = 'cyan'
truncation_length = 3
truncate_to_repo = true

[git_branch]
format = ' $branch'
style = 'green'

[git_status]
format = '([ $ahead_behind](yellow))([*](red))'
style = 'yellow'
ignore_submodules = true
ahead = '↑${count}'
behind = '↓${count}'
diverged = '↑${ahead_count}↓${behind_count}'
conflicted = '*'
untracked = '*'
stashed = ''
modified = '*'
staged = '*'
renamed = '*'
deleted = '*'

[character]
success_symbol = ''
error_symbol = '[!](red)'
{{- end -}}
