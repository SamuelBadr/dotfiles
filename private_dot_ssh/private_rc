# ~/.ssh/rc: sshd runs this on every login (sshd(8), SSHRC). Keep it silent:
# output here would corrupt scp/rsync.

# Keep ~/.ssh/agent.sock pointing at a working forwarded agent; shells inside
# long-lived herdr/tmux sessions use that path (see ~/.config/shell/common.sh),
# so they survive reconnects. Repoint only when the current target is dead, so
# a short `ssh host cmd` can't steal the link from a live session; `timeout`
# catches sockets of sshd sessions whose client vanished (laptop slept).
link=$HOME/.ssh/agent.sock
if [ -S "${SSH_AUTH_SOCK:-}" ] && [ "$SSH_AUTH_SOCK" != "$link" ]; then
	SSH_AUTH_SOCK=$link timeout 3 ssh-add -l >/dev/null 2>&1
	[ $? -le 1 ] || ln -sfn "$SSH_AUTH_SOCK" "$link" 2>/dev/null
fi

# Any ~/.ssh/rc disables sshd's default xauth step for X11 forwarding; redo it.
if read -r proto cookie && [ -n "${DISPLAY:-}" ]; then
	case $DISPLAY in
	localhost:*) display=unix:${DISPLAY#localhost:} ;;
	*) display=$DISPLAY ;;
	esac
	echo "add $display $proto $cookie" | xauth -q -
fi
