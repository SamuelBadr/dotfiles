# Shared by every machine. Only the macOS Keychain options and the backup host
# are machine-specific.
{{- if eq .chezmoi.os "darwin" }}
IgnoreUnknown UseKeychain

Host *
	AddKeysToAgent yes
	UseKeychain yes
{{- end }}

Host VSC4 VSC5 VSC4B VSC5B
	Port 27
	IdentitiesOnly yes

# 2FA clusters: the user logs in once on hclm (`ssh -fN <host>`) and agents reuse
# that master until the connection drops (days); auth is only checked at login.
Host VSC4 VSC5 VSC4B VSC5B MUSICA MUSICA-LNZ MUSICA-INN
	ControlPersist yes
	ServerAliveInterval 60   # keep the idle master alive so the HPC doesn't drop it
	ServerAliveCountMax 4

Host VSC4B VSC5B
	User samuelb

Host VSC4 VSC5
	User samuel

Host VSC4 VSC4B
	HostName vsc4.vsc.ac.at

Host VSC5 VSC5B
	HostName vsc5.vsc.ac.at

Host MUSICA
	User sb69466
	HostName 193.170.79.22
	HostKeyAlias musica-193.170.79.22

Host MUSICA-LNZ MUSICA-INN
	User sb69466

# Daily step certificate (see ~/bin/fleet); missing files are skipped.
Host MUSICA MUSICA-LNZ MUSICA-INN
	IdentityFile ~/.ssh/asc
	CertificateFile ~/.ssh/asc-cert.pub

Host MUSICA-LNZ
	HostName musica.lnz.asc.ac.at

Host MUSICA-INN
	HostName musica.inn.asc.ac.at

# kauch and frank over the tailnet, except from hclm, which is not on it (the
# user does not want a daemon on the shared login node), so everyone reaches
# hclm directly. The tailnet holds only your devices, so host keys are accepted
# unprompted under the new names. frank runs Tailscale without root
# (tailscaled.service), so from there connections go through `tailscale nc`.
# Direct addresses, should the tailnet be down: kauch 128.131.127.236,
# frank 128.131.126.112.
{{- $tailnet := ne .chezmoi.hostname "master" }}
{{- if $tailnet }}
Match originalhost kauch,frank exec "test -S /run/user/$(id -u)/tailscale.sock"
	ProxyCommand ~/bin/tailscale --socket=/run/user/$(id -u)/tailscale.sock nc %h %p

Host kauch frank
	StrictHostKeyChecking accept-new
{{- end }}

Host kauch
	User samuel
	HostName {{ if $tailnet }}kauch01.tailb493b.ts.net{{ else }}128.131.127.236{{ end }}

Host hclm
	User samuel
	Hostname hclm.ifp.tuwien.ac.at
{{- if .modules.backupMac }}

Host hclm-backup
	User samuel
	Hostname hclm.ifp.tuwien.ac.at
	IdentityFile ~/.ssh/id_rsa
	IdentitiesOnly yes
	BatchMode yes
	StrictHostKeyChecking yes
	ControlPath none         # don't share (possibly stale) interactive hclm masters
{{- end }}

Host frank
	User samuel
	Hostname {{ if $tailnet }}frank.tailb493b.ts.net{{ else }}128.131.126.112{{ end }}
	Port 10492
	IdentitiesOnly yes

Host CMSuebung
	User cms2025_10
	Hostname server4.physprak.tuwien.ac.at
	IdentitiesOnly yes

Host *
	ServerAliveInterval 15
	ServerAliveCountMax 3
	ControlMaster auto
	ControlPath ~/.ssh/control-%C
	ControlPersist 10m
