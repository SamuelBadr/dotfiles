# Shared by every machine. Only the darwin block (this Mac holds the private
# keys) and the backup host are machine-specific.
{{- if eq .chezmoi.os "darwin" }}
IgnoreUnknown UseKeychain

# Trusted hosts: forward the Mac's agent so Pi there can ssh/rsync onwards.
# Remotes don't re-forward it (this block exists only on the Mac).
Host hclm kauch frank VSC4 VSC5 VSC4B VSC5B MUSICA
	ForwardAgent yes

Host *
	AddKeysToAgent yes
	UseKeychain yes
{{- end }}

Host VSC4 VSC5 VSC4B VSC5B
	Port 27

Host VSC4B VSC5B
	User samuelb
	ControlPersist 8h       # VSC 2FA: auth once per work session; herdr reuses this master
	ServerAliveInterval 60   # keep the idle master alive so the HPC doesn't drop it
	ServerAliveCountMax 4

Host VSC4 VSC5
	User samuel

Host VSC4 VSC4B
	HostName vsc4.vsc.ac.at

Host VSC5 VSC5B
	HostName vsc5.vsc.ac.at

Host MUSICA
	User sb69466
	HostName 193.170.79.22
	HostKeyAlias musica-193.170.79.22

Host kauch
	User samuel
	HostName 128.131.127.236

Host hclm
	User samuel
	Hostname hclm.ifp.tuwien.ac.at
{{- if .modules.backupMac }}

Host hclm-backup
	User samuel
	Hostname hclm.ifp.tuwien.ac.at
	IdentityFile ~/.ssh/id_rsa
	IdentitiesOnly yes
	BatchMode yes
	StrictHostKeyChecking yes
	ControlPath none         # don't share (possibly stale) interactive hclm masters
{{- end }}

Host frank
	User samuel
	Hostname 128.131.126.112
	Port 10492

Host CMSuebung
	User cms2025_10
	Hostname server4.physprak.tuwien.ac.at

Host *
	ServerAliveInterval 15
	ServerAliveCountMax 3
	ControlMaster auto
	ControlPath ~/.ssh/control-%C
	ControlPersist 10m
