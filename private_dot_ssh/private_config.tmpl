# Shared by every machine. Only the macOS Keychain options and the backup host
# are machine-specific.
{{- if eq .chezmoi.os "darwin" }}
IgnoreUnknown UseKeychain

Host *
	AddKeysToAgent yes
	UseKeychain yes
{{- end }}

Host VSC4 VSC5 VSC4B VSC5B
	Port 27
	IdentitiesOnly yes

# 2FA clusters: the user logs in once on hclm (`ssh -fN <host>`) and agents reuse
# that master until the connection drops (days); auth is only checked at login.
Host VSC4 VSC5 VSC4B VSC5B MUSICA MUSICA-LNZ MUSICA-INN
	ControlPersist yes
	ServerAliveInterval 60   # keep the idle master alive so the HPC doesn't drop it
	ServerAliveCountMax 4

Host VSC4B VSC5B
	User samuelb

Host VSC4 VSC5
	User samuel

Host VSC4 VSC4B
	HostName vsc4.vsc.ac.at

Host VSC5 VSC5B
	HostName vsc5.vsc.ac.at

Host MUSICA
	User sb69466
	HostName 193.170.79.22
	HostKeyAlias musica-193.170.79.22

Host MUSICA-LNZ MUSICA-INN
	User sb69466

# Daily step certificate (see ~/bin/fleet); missing files are skipped.
Host MUSICA MUSICA-LNZ MUSICA-INN
	IdentityFile ~/.ssh/asc
	CertificateFile ~/.ssh/asc-cert.pub

Host MUSICA-LNZ
	HostName musica.lnz.asc.ac.at

Host MUSICA-INN
	HostName musica.inn.asc.ac.at

# kauch, hclm and frank over the tailnet. It holds only your devices, so their
# host keys are accepted unprompted under these new names. hclm and frank run
# Tailscale without root (tailscaled.service), so from there connections go
# through `tailscale nc`. Direct addresses, should the tailnet be down:
# kauch 128.131.127.236, hclm hclm.ifp.tuwien.ac.at, frank 128.131.126.112.
Match originalhost kauch,hclm,frank exec "test -S /run/user/$(id -u)/tailscale.sock"
	ProxyCommand ~/bin/tailscale --socket=/run/user/$(id -u)/tailscale.sock nc %h %p

Host kauch hclm frank
	StrictHostKeyChecking accept-new

Host kauch
	User samuel
	HostName kauch01.tailb493b.ts.net

Host hclm
	User samuel
	Hostname hclm.tailb493b.ts.net
{{- if .modules.backupMac }}

Host hclm-backup
	User samuel
	Hostname hclm.ifp.tuwien.ac.at
	IdentityFile ~/.ssh/id_rsa
	IdentitiesOnly yes
	BatchMode yes
	StrictHostKeyChecking yes
	ControlPath none         # don't share (possibly stale) interactive hclm masters
{{- end }}

Host frank
	User samuel
	Hostname frank.tailb493b.ts.net
	Port 10492
	IdentitiesOnly yes

Host CMSuebung
	User cms2025_10
	Hostname server4.physprak.tuwien.ac.at
	IdentitiesOnly yes

Host *
	ServerAliveInterval 15
	ServerAliveCountMax 3
	ControlMaster auto
	ControlPath ~/.ssh/control-%C
	ControlPersist 10m
