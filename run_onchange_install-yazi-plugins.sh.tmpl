#!/bin/sh
# Install Yazi packages pinned in package.toml (git rev + hash).
# run_onchange: re-runs only when this script's content changes, i.e. when the
# package.toml checksum below changes (plugin pins bumped). Yazi is optional on
# headless machines, so do not fail when the workstation module is disabled.
# package.toml hash: {{ include "private_dot_config/yazi/package.toml" | sha256sum }}
if [ "{{ .modules.workstation }}" != "true" ]; then
	exit 0
fi
if ! command -v ya >/dev/null 2>&1; then
	echo "ya (yazi package manager) not found; install yazi first, then: ya pkg install" >&2
	exit 1
fi
ya pkg install
