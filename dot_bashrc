# ============================================================================
# Environment Variables
# ============================================================================
# Editor: VS Code on macOS, VS Code in VS Code terminal on Linux, otherwise nvim
if [[ "$OSTYPE" == darwin* ]]; then
  export EDITOR="code --wait --new-window"
elif [[ "${TERM_PROGRAM:-}" == "vscode" ]]; then
  export EDITOR="code --wait --new-window"
else
  export EDITOR="nvim"
fi
export VISUAL="$EDITOR"
export GITHUB_USERNAME="SamuelBadr"

export OPENCODE_EXPERIMENTAL_LSP_TOOL=true

# Path configuration
export PATH="$HOME/.bun/bin:$HOME/.cargo/bin:$HOME/.julia/bin:$HOME/bin:$HOME/.local/bin:$PATH"

# macOS key repeat tweaks (runs whenever an interactive shell starts on macOS)
if [[ "$OSTYPE" == darwin* ]]; then
  defaults write -g InitialKeyRepeat -int 15
  defaults write -g KeyRepeat -int 2
  defaults write NSGlobalDomain ApplePressAndHoldEnabled -bool false
fi

# ============================================================================
# Only run the rest for interactive shells
# ============================================================================
[[ $- != *i* ]] && return

# ============================================================================
# History Configuration (Bash equivalents)
# ============================================================================
export HISTFILE="$HOME/.bash_history"
export HISTSIZE=50000
export HISTFILESIZE=50000

# Append rather than overwrite; multi-line commands as single entry
shopt -s histappend
shopt -s cmdhist

# Similar to: ignore leading space + ignore duplicates + erase older dups
# (erasedups is supported on modern bash; harmless if not)
export HISTCONTROL="ignoreboth:erasedups"

# Share history across sessions (approximation of zsh SHARE_HISTORY):
# -a: append new lines to HISTFILE each prompt
# -n: read new lines from HISTFILE each prompt
__hist_sync() { history -a; history -n; }
case "${PROMPT_COMMAND:-}" in
  *__hist_sync*) : ;;
  "") PROMPT_COMMAND="__hist_sync" ;;
  *)  PROMPT_COMMAND="__hist_sync; $PROMPT_COMMAND" ;;
esac

# ============================================================================
# Bash Options (shopt/readline equivalents)
# ============================================================================
# AUTO_CD
shopt -s autocd 2>/dev/null || true

# Directory stack behavior similar to AUTO_PUSHD / PUSHD_* (best-effort)
shopt -s pushdignoredups 2>/dev/null || true
shopt -s pushdsilent     2>/dev/null || true
shopt -s pushdminus      2>/dev/null || true

# INTERACTIVE_COMMENTS
shopt -s interactive_comments

# ============================================================================
# Completion (bash-completion) + Readline tuning
# ============================================================================
# Enable bash-completion if available (Homebrew / Linux common paths)
if command -v brew >/dev/null 2>&1; then
  if [[ -r "$(brew --prefix)/etc/profile.d/bash_completion.sh" ]]; then
    # Homebrew bash-completion@2
    source "$(brew --prefix)/etc/profile.d/bash_completion.sh"
  elif [[ -r "$(brew --prefix)/share/bash-completion/bash_completion" ]]; then
    source "$(brew --prefix)/share/bash-completion/bash_completion"
  fi
fi
[[ -r /usr/share/bash-completion/bash_completion ]] && source /usr/share/bash-completion/bash_completion
[[ -r /etc/bash_completion ]] && source /etc/bash_completion

# Completion styling-ish (readline; not as powerful as zstyle)
bind 'set completion-ignore-case on'
bind 'set show-all-if-ambiguous on'
bind 'set menu-complete-display-prefix on' 2>/dev/null || true

# ============================================================================
# Key Bindings (readline)
# ============================================================================
set -o emacs

# Prefix history search on Up/Down (similar vibe to up-line-or-beginning-search)
bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'
bind '"\C-p": history-search-backward'
bind '"\C-n": history-search-forward'

