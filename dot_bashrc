# ============================================================================
# ~/.bashrc — interactive bash (fallback shell).
# The canonical interactive shell is zsh; bash is kept as a thin fallback for
# machines (e.g. HPC login nodes) where zsh is not user-installable. Shared,
# shell-neutral setup lives in ~/.config/shell/common.sh.
# ============================================================================

# Shared environment; also needed for non-interactive bash.
[ -r "$HOME/.config/shell/common.sh" ] && . "$HOME/.config/shell/common.sh"

# ============================================================================
# Only run the rest for interactive shells
# ============================================================================
[[ $- != *i* ]] && return

# Hand off interactive non-login bash to per-user zsh on machines with a
# rootless zsh install (~/.local/bin/zsh). Login bash is handled in .bash_profile.
if [[ -x "$HOME/.local/bin/zsh" ]]; then
  exec "$HOME/.local/bin/zsh"
fi

# ============================================================================
# Interactive fallback (no user-local zsh on this machine)
# ============================================================================
# History
export HISTFILE="$HOME/.bash_history"
export HISTSIZE=50000
export HISTFILESIZE=50000

# Append rather than overwrite; multi-line commands as single entry
shopt -s histappend
shopt -s cmdhist

# Similar to: ignore leading space + ignore duplicates + erase older dups
export HISTCONTROL="ignoreboth:erasedups"

# Share history across sessions: -a append each prompt, -n read new lines.
__hist_sync() { history -a; history -n; }
case "${PROMPT_COMMAND:-}" in
  *__hist_sync*) : ;;
  "") PROMPT_COMMAND="__hist_sync" ;;
  *)  PROMPT_COMMAND="__hist_sync; $PROMPT_COMMAND" ;;
esac

# Options
shopt -s autocd 2>/dev/null || true
shopt -s interactive_comments

# Completion (bash-completion) + readline tuning
if command -v brew >/dev/null 2>&1; then
  if [[ -r "$(brew --prefix)/etc/profile.d/bash_completion.sh" ]]; then
    source "$(brew --prefix)/etc/profile.d/bash_completion.sh"
  elif [[ -r "$(brew --prefix)/share/bash-completion/bash_completion" ]]; then
    source "$(brew --prefix)/share/bash-completion/bash_completion"
  fi
fi
[[ -r /usr/share/bash-completion/bash_completion ]] && source /usr/share/bash-completion/bash_completion
[[ -r /etc/bash_completion ]] && source /etc/bash_completion

bind 'set completion-ignore-case on'
bind 'set show-all-if-ambiguous on'
bind 'set menu-complete-display-prefix on' 2>/dev/null || true

# Key bindings
set -o emacs
bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'
bind '"\C-p": history-search-backward'
bind '"\C-n": history-search-forward'

# Prompt
if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
else
  # Fallback (e.g. HPC nodes): starship's layout minus git flags and timing.
  # Must run first in PROMPT_COMMAND to see $?; stripping keeps re-sourcing idempotent.
  __ps1_update() {
    local rc=$?
    __ps1_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    __ps1_exit='' __ps1_color=35
    if (( rc )); then __ps1_exit="exit $rc" __ps1_color=31; fi
  }
  PROMPT_COMMAND="__ps1_update; ${PROMPT_COMMAND#__ps1_update; }"
  PS1='\n\[\e[32m\]\h\[\e[0m\]:\[\e[36m\]\w\[\e[0m\]${__ps1_branch:+ \[\e[35m\]$__ps1_branch\[\e[0m\]}${__ps1_exit:+  \[\e[31m\]$__ps1_exit\[\e[0m\]}\n\[\e[${__ps1_color}m\]>\[\e[0m\] '
fi
