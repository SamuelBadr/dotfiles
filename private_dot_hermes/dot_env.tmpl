{{- if .modules.hermes -}}
# Hermes Agent Environment Configuration
# Managed by chezmoi - DO NOT edit directly
# Run `chezmoi edit --prompt .env` to make changes
#
# Secrets are managed by chezmoi's secrets manager.
# Run `chezmoi secret set <name>` to add/update secrets.

# =============================================================================
# LLM PROVIDER (Custom Endpoint)
# =============================================================================
# Your custom LLM endpoint (configured in config.yaml)
# API key stored as chezmoi secret: hermes_api_key

# =============================================================================
# TOOL API KEYS
# =============================================================================

# Firecrawl API Key - Web search, extract, and crawl
# Get at: https://firecrawl.dev/
FIRECRAWL_API_KEY={{ .firecrawl_api_key | default "" }}

# =============================================================================
# MESSAGING PLATFORMS
# =============================================================================

# Telegram Bot Token - From @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN={{ .telegram_bot_token | default "" }}

# =============================================================================
# TERMINAL TOOL CONFIGURATION
# =============================================================================

# Backend type: "local", "singularity", "docker", "modal", or "ssh"
TERMINAL_ENV=local

# SUDO password (only if needed for local commands)
# WARNING: Stored encrypted by chezmoi
SUDO_PASSWORD={{ .sudo_password | default "" }}

# Container image for modal backend
TERMINAL_MODAL_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20

# Command timeout and lifetime
TERMINAL_TIMEOUT=60
TERMINAL_LIFETIME_SECONDS=300

# =============================================================================
# BROWSER TOOL CONFIGURATION
# =============================================================================

# Browserbase settings (if using cloud browser)
BROWSERBASE_PROXIES=true
BROWSERBASE_ADVANCED_STEALTH=false
BROWSER_SESSION_TIMEOUT=300
BROWSER_INACTIVITY_TIMEOUT=120

# =============================================================================
# DEBUG OPTIONS
# =============================================================================
WEB_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
MOA_TOOLS_DEBUG=false
IMAGE_TOOLS_DEBUG=false

# =============================================================================
# DISABLED / COMMENTED OUT KEYS (Add as needed)
# =============================================================================

# Exa API Key - AI-native web search
# EXA_API_KEY={{ .exa_api_key }}

# Parallel API Key - AI-native web search and extract
# PARALLEL_API_KEY={{ .parallel_api_key }}

# FAL.ai API Key - Image generation
# FAL_KEY={{ .fal_key }}

# OpenRouter API Key (if using instead of custom endpoint)
# OPENROUTER_API_KEY={{ .openrouter_api_key }}

# Google Gemini API Key
# GOOGLE_API_KEY={{ .google_api_key }}

# Groq API Key (for Whisper STT)
# GROQ_API_KEY={{ .groq_api_key }}

# GitHub Token (for higher rate limits on skill hub)
# GITHUB_TOKEN={{ .github_token | default "" }}
{{- end -}}
