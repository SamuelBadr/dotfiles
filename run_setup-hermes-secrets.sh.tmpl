{{- if not .modules.hermes -}}
#!/usr/bin/env bash
# Hermes module is disabled. Exiting.
exit 0
{{- else -}}
#!/bin/bash
# Hermes Agent Secrets Setup
# Secrets are loaded from .chezmoidata.toml (plaintext in repo)
# No interactive setup needed

set -e

echo "==> Hermes module enabled"
echo "  Secrets loaded from .chezmoidata.toml"
echo "  (Firecrawl, Telegram, sudo password configured)"
echo ""
echo "  Note: Secrets are stored in plaintext in your dotfiles repo."
echo "  For better security, consider using a keyring or age encryption."
echo ""
echo "==> Hermes setup complete"
{{- end -}}
