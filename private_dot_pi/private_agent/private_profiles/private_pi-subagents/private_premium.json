        "thinking": "medium",
        "fallbackModels": [
          "aqueduct/main",
          "openai-codex/gpt-5.6-sol"
        ]
      },
      "reviewer": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "medium",
        "fallbackModels": [
          "aqueduct/main",
          "openai-codex/gpt-5.6-sol"
        ]
      },
      "verifier": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "medium",
