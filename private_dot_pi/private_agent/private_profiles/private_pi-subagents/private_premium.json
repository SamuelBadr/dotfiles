{
  "subagents": {
    "defaultModel": "openai-codex/gpt-5.6-terra",
    "modelScope": {
      "enforce": true,
      "allow": [
        "openai-codex/gpt-5.6-*",
        "aqueduct/main"
      ]
    },
    "agentOverrides": {
      "delegate": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "medium",
        "fallbackModels": [
          "aqueduct/main",
          "openai-codex/gpt-5.6-luna"
        ]
      },
      "scout": {
        "model": "openai-codex/gpt-5.6-luna",
        "thinking": "low",
        "fallbackModels": [
          "aqueduct/main",
          "openai-codex/gpt-5.6-terra"
        ]
      },
      "context-builder": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "medium",
        "fallbackModels": [
          "aqueduct/main",
          "openai-codex/gpt-5.6-sol"
        ]
      },
      "researcher": {
        "model": "openai-codex/gpt-5.6-terra",
        "thinking": "medium",
        "fallbackModels": [
          "aqueduct/main",
          "openai-codex/gpt-5.6-sol"
        ]
      },
      "planner": {
        "model": "openai-codex/gpt-5.6-sol",
        "thinking": "high",
        "fallbackModels": [
          "aqueduct/main",
