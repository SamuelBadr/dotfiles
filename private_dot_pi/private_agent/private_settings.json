{
  "lastChangelogVersion": "0.83.0",
  "defaultProvider": "deepseek",
  "defaultModel": "deepseek-v4-flash",
  "defaultThinkingLevel": "max",
  "theme": "light/dark",
  "enableInstallTelemetry": false,
  "packages": [
    "npm:pi-markdown-preview",
    "npm:pi-subagents",
    "npm:pi-web-access",
    "npm:pi-fff",
    "git:github.com/algal/pi-openai-server-compaction",
    "git:github.com/DietrichGebert/ponytail"
  ],
  "enabledModels": [
    "aqueduct/main",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-sol",
    "deepseek/deepseek-v4-flash"
  ],
  "subagents": {
    "defaultModel": "aqueduct/main",
    "modelScope": {
      "enforce": true,
      "allow": [
        "aqueduct/main",
        "openai-codex/gpt-5.6-*"
      ]
    },
    "agentOverrides": {
      "delegate": {
        "model": "aqueduct/main",
        "thinking": "medium",
        "fallbackModels": [
          "openai-codex/gpt-5.6-luna",
          "openai-codex/gpt-5.6-terra"
        ]
      },
      "scout": {
        "model": "aqueduct/main",
        "thinking": "low",
        "fallbackModels": [
          "openai-codex/gpt-5.6-luna",
          "openai-codex/gpt-5.6-terra"
        ],
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "write",
          "contact_supervisor"
        ]
      },
      "context-builder": {
        "model": "aqueduct/main",
        "thinking": "medium",
        "fallbackModels": [
          "openai-codex/gpt-5.6-terra",
          "openai-codex/gpt-5.6-sol"
        ],
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "write",
          "web_search",
          "contact_supervisor"
        ]
      },
      "researcher": {
        "model": "aqueduct/main",
        "thinking": "medium",
        "fallbackModels": [
          "openai-codex/gpt-5.6-terra",
          "openai-codex/gpt-5.6-sol"
        ],
        "tools": [
          "read",
          "write",
          "web_search",
          "fetch_content",
          "get_search_content",
          "contact_supervisor"
        ]
      },
      "planner": {
        "model": "aqueduct/main",
        "thinking": "high",
        "fallbackModels": [
          "openai-codex/gpt-5.6-sol",
          "openai-codex/gpt-5.6-terra"
        ],
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "write",
          "contact_supervisor"
        ]
      },
      "oracle": {
        "model": "aqueduct/main",
        "thinking": "high",
        "fallbackModels": [
          "openai-codex/gpt-5.6-sol",
          "openai-codex/gpt-5.6-terra"
        ],
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "contact_supervisor"
        ]
      },
      "advisor": {
        "model": "aqueduct/main",
        "thinking": "high",
        "fallbackModels": [
          "openai-codex/gpt-5.6-sol",
          "openai-codex/gpt-5.6-terra"
        ]
      },
      "worker": {
        "model": "aqueduct/main",
        "thinking": "medium",
        "fallbackModels": [
          "openai-codex/gpt-5.6-terra",
          "openai-codex/gpt-5.6-sol"
        ]
      },
      "reviewer": {
        "model": "aqueduct/main",
        "thinking": "high",
        "fallbackModels": [
          "openai-codex/gpt-5.6-terra",
          "openai-codex/gpt-5.6-sol"
        ],
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write",
          "contact_supervisor"
        ]
      },
      "verifier": {
        "model": "aqueduct/main",
        "thinking": "medium",
        "fallbackModels": [
          "openai-codex/gpt-5.6-terra",
          "openai-codex/gpt-5.6-sol"
        ]
      }
    }
  }
}