{
  "lastChangelogVersion": "0.80.10",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "high",
  "theme": "light/dark",
  "enableInstallTelemetry": false,
  "packages": [
    "npm:pi-markdown-preview",
    "npm:pi-subagents",
    "npm:@plannotator/pi-extension",
    "npm:pi-web-access",
    "npm:pi-fff"
  ],
  "enabledModels": [
    "aqueduct/large",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-luna"
  ],
  "subagents": {
    "defaultModel": "aqueduct/main",
    "modelScope": {
      "enforce": true,
      "allow": [
        "openai-codex/gpt-5.6-*",
        "aqueduct/main",
        "aqueduct/coding",
        "aqueduct/large",
        "aqueduct/tiny",
        "aqueduct/util",
        "aqueduct/vision",
        "aqueduct/ocr"
      ]
    },
    "agentOverrides": {
      "delegate": {
        "model": "aqueduct/util",
        "fallbackModels": [
          "aqueduct/tiny",
          "aqueduct/main"
        ]
      },
      "scout": {
        "model": "aqueduct/coding",
        "thinking": "low",
        "fallbackModels": [
          "aqueduct/main",
          "aqueduct/large"
        ],
        "tools": ["read", "grep", "find", "ls", "bash", "write"]
      },
      "context-builder": {
        "model": "aqueduct/large",
        "thinking": "medium",
        "fallbackModels": [
          "aqueduct/main",
          "aqueduct/coding"
        ],
        "tools": ["read", "grep", "find", "ls", "bash", "write", "web_search"]
      },
      "researcher": {
        "model": "aqueduct/main",
        "thinking": "medium",
        "fallbackModels": [
          "aqueduct/large",
          "aqueduct/coding"
        ],
        "tools": ["read", "write", "web_search", "fetch_content", "get_search_content"]
      },
      "planner": {
        "model": "aqueduct/large",
        "thinking": "high",
        "fallbackModels": [
          "aqueduct/main",
          "aqueduct/coding"
        ],
        "tools": ["read", "grep", "find", "ls", "write"]
      },
      "oracle": {
        "model": "aqueduct/large",
        "thinking": "high",
        "fallbackModels": [
          "aqueduct/main",
          "aqueduct/coding"
        ],
        "tools": ["read", "grep", "find", "ls", "bash"]
      },
      "worker": {
        "model": "aqueduct/coding",
        "thinking": "medium",
        "fallbackModels": [
          "aqueduct/main",
          "aqueduct/large"
        ]
      },
      "reviewer": {
        "model": "aqueduct/large",
        "thinking": "high",
        "fallbackModels": [
          "aqueduct/coding",
          "aqueduct/main"
        ],
        "tools": ["read", "grep", "find", "ls", "bash", "edit", "write"]
      },
      "verifier": {
        "model": "aqueduct/main",
        "fallbackModels": [
          "aqueduct/large",
          "aqueduct/coding"
        ]
      }
    }
  }
}