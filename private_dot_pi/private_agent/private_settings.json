{
  "lastChangelogVersion": "0.83.0",
  "defaultProvider": "aqueduct",
  "defaultModel": "large",
  "defaultThinkingLevel": "max",
  "theme": "light/dark",
  "enableInstallTelemetry": false,
  "packages": [
    "npm:pi-markdown-preview",
    "npm:pi-subagents",
    "npm:pi-web-access",
    "npm:pi-fff",
    "git:github.com/algal/pi-openai-server-compaction",
    "git:github.com/DietrichGebert/ponytail"
  ],
  "enabledModels": [
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-sol",
    "deepseek/deepseek-v4-flash",
    "aqueduct/large"
  ],
  "subagents": {
    "defaultModel": "aqueduct/large",
    "modelScope": {
      "enforce": true,
      "allow": [
        "aqueduct/main",
        "aqueduct/large",
        "openai-codex/gpt-5.6-*"
      ]
    },
    "agentOverrides": {
      "delegate": {
        "model": "aqueduct/large",
        "thinking": "high"
      },
      "scout": {
        "model": "aqueduct/main",
        "thinking": "low"
      },
      "context-builder": {
        "model": "aqueduct/large",
        "thinking": "high"
      },
      "researcher": {
        "model": "aqueduct/large",
        "thinking": "high"
      },
      "planner": {
        "model": "aqueduct/large",
        "thinking": "max"
      },
      "oracle": {
        "model": "aqueduct/large",
        "thinking": "max"
      },
      "advisor": {
        "model": "aqueduct/large",
        "thinking": "max"
      },
      "worker": {
        "model": "aqueduct/large",
        "thinking": "high"
      },
      "reviewer": {
        "model": "aqueduct/large",
        "thinking": "max"
      },
      "verifier": {
        "model": "aqueduct/large",
        "thinking": "high"
      }
    }
  }
}