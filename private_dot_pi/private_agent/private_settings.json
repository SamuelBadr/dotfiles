{
  "lastChangelogVersion": "0.83.0",
  "defaultProvider": "aqueduct",
  "defaultModel": "large",
  "defaultThinkingLevel": "max",
  "theme": "light/dark",
  "enableInstallTelemetry": false,
  "packages": [
    "npm:pi-markdown-preview",
    "npm:pi-subagents",
    "npm:@plannotator/pi-extension",
    "npm:pi-web-access",
    "npm:pi-fff",
    "git:github.com/algal/pi-openai-server-compaction",
    "npm:@narumitw/pi-goal",
    "git:github.com/DietrichGebert/ponytail"
  ],
  "enabledModels": [
    "aqueduct/large",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-luna",
    "deepseek/deepseek-v4-flash"
  ],
  "subagents": {
    "defaultModel": "aqueduct/main",
    "modelScope": {
      "enforce": true,
      "allow": [
        "openai-codex/gpt-5.6-*",
        "aqueduct/main",
        "aqueduct/coding",
        "aqueduct/large",
        "aqueduct/tiny",
        "aqueduct/util",
        "aqueduct/vision",
        "aqueduct/ocr"
      ]
    },
    "agentOverrides": {
      "delegate": {
        "model": "aqueduct/util",
        "fallbackModels": [
          "aqueduct/tiny",
          "aqueduct/main"
        ]
      },
      "scout": {
        "model": "aqueduct/coding",
        "thinking": "low",
        "fallbackModels": [
          "aqueduct/main",
          "aqueduct/large"
        ],
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "write",
          "contact_supervisor"
        ]
      },
      "context-builder": {
        "model": "aqueduct/large",
        "thinking": "medium",
        "fallbackModels": [
          "aqueduct/main",
          "aqueduct/coding"
        ],
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "write",
          "web_search",
          "contact_supervisor"
        ]
      },
      "researcher": {
        "model": "aqueduct/main",
        "thinking": "medium",
        "fallbackModels": [
          "aqueduct/large",
          "aqueduct/coding"
        ],
        "tools": [
          "read",
          "write",
          "web_search",
          "fetch_content",
          "get_search_content",
          "contact_supervisor"
        ]
      },
      "planner": {
        "model": "aqueduct/large",
        "thinking": "high",
        "fallbackModels": [
          "aqueduct/main",
          "aqueduct/coding"
        ],
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "write",
          "contact_supervisor"
        ]
      },
      "oracle": {
        "model": "aqueduct/large",
        "thinking": "high",
        "fallbackModels": [
          "aqueduct/main",
          "aqueduct/coding"
        ],
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "contact_supervisor"
        ]
      },
      "worker": {
        "model": "aqueduct/coding",
        "thinking": "medium",
        "fallbackModels": [
          "aqueduct/main",
          "aqueduct/large"
        ]
      },
      "reviewer": {
        "model": "aqueduct/large",
        "thinking": "high",
        "fallbackModels": [
          "aqueduct/coding",
          "aqueduct/main"
        ],
        "tools": [
          "read",
          "grep",
          "find",
          "ls",
          "bash",
          "edit",
          "write",
          "contact_supervisor"
        ]
      },
      "verifier": {
        "model": "aqueduct/main",
        "fallbackModels": [
          "aqueduct/large",
          "aqueduct/coding"
        ]
      }
    }
  }
}