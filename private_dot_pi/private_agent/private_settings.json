{
  "lastChangelogVersion": "0.84.4",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "defaultThinkingLevel": "max",
  "theme": "light/dark",
  "enableInstallTelemetry": false,
  "packages": [
    "npm:pi-subagents",
    "npm:pi-web-access",
    "npm:pi-fff",
    "git:github.com/algal/pi-openai-server-compaction",
    "git:github.com/DietrichGebert/ponytail",
    "https://github.com/gsanhueza/pi-token-speed",
    "npm:pi-context-view",
    "git:github.com/jonjonrankin/pi-caveman"
  ],
  "enabledModels": [
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "aqueduct/deepseek-v4-flash-284b",
    "bansos/x-preview-f-free"
  ],
  "subagents": {
    "defaultModel": "aqueduct/deepseek-v4-flash-284b",
    "modelScope": {
      "enforce": true,
      "allow": [
        "aqueduct/main",
        "aqueduct/large",
        "openai-codex/gpt-5.6-*",
        "aqueduct/deepseek-v4-flash-284b"
      ]
    },
    "agentOverrides": {
      "delegate": {
        "model": "aqueduct/deepseek-v4-flash-284b",
        "thinking": "high"
      },
      "scout": {
        "model": "aqueduct/deepseek-v4-flash-284b",
        "thinking": "low"
      },
      "context-builder": {
        "model": "aqueduct/deepseek-v4-flash-284b",
        "thinking": "high"
      },
      "researcher": {
        "model": "aqueduct/deepseek-v4-flash-284b",
        "thinking": "high"
      },
      "planner": {
        "model": "aqueduct/large",
        "thinking": "max"
      },
      "oracle": {
        "model": "aqueduct/large",
        "thinking": "max"
      },
      "advisor": {
        "model": "aqueduct/large",
        "thinking": "max"
      },
      "worker": {
        "model": "aqueduct/deepseek-v4-flash-284b",
        "thinking": "high"
      },
      "reviewer": {
        "model": "aqueduct/large",
        "thinking": "max"
      },
      "verifier": {
        "model": "aqueduct/deepseek-v4-flash-284b",
        "thinking": "high"
      }
    }
  },
  "tuiMode": "fullscreen",
  "outputPad": 1
}